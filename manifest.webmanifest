{
  "name": "WonderPlay — Learn & Play",
  "short_name": "WonderPlay",
  "description": "Five playful mini-games for kids: shapes, numbers, colours, jigsaw puzzles and balloon popping.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "any",
  "background_color": "#EEF4FF",
  "theme_color": "#EEF4FF",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "games", "kids"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/favicon-32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "/icons/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Balloon Pop", "short_name": "Balloons", "url": "/?game=balloons",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sticker Book", "short_name": "Stickers", "url": "/?game=book",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
